# Copy to .env in the directory from which you run node examples/<case>.ts (Node 24+).
# Running a launch-erc20/erc404 .ts case deliberately signs, spends native ETH and publishes.
# Configure exactly one signer source; leave PRIVATE_KEY blank when using a keystore.
PRIVATE_KEY=
# EXAMPLE_KEYSTORE_PATH=/absolute/path/to/owner-only-v3-scrypt-keystore
# EXAMPLE_KEYSTORE_PASSWORD=
LAUNCH_API_URL=

# Optional: blank uses the SDK official Robinhood chain-4663 mainnet RPC.
RPC_URL=
# Optional ERC404 NFT metadata base URI that you actually host; blank means empty URI.
NFT_BASE_URI=

# Optional native ETH conversion input PER BUY (Kyber Swap funding for WETH/USDG).
# EXAMPLE_BUY_AMOUNT_WEI=10000000000000
# Optional Kyber API origin; unset uses LAUNCH_API_URL. No route/funding fallback.
# EXAMPLE_KYBER_API_URL=
# Optional exact USD target, token identity and actual PNG/JPEG/WebP artwork.
# EXAMPLE_TARGET_MARKET_CAP_USD=5000
# EXAMPLE_TOKEN_NAME=
# EXAMPLE_TOKEN_SYMBOL=
# EXAMPLE_TOKEN_DESCRIPTION=
# EXAMPLE_IMAGE_PATH=/absolute/path/to/image.png

# Optional local tightening restrictions. Blank/unset means unknown, not refused.
# Nitro protocol compute caps and poster budgeting are read natively at the pinned block.
# EXAMPLE_CHAIN_GAS_CAP=
# EXAMPLE_RPC_GAS_CAP=
# EXAMPLE_ACCOUNT_GAS_CAP=
# EXAMPLE_MAX_CALLDATA_BYTES=
# EXAMPLE_HEADROOM_BPS=1500
